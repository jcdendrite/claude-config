__pycache__/
.pytest_cache/
.venv/

# macOS Finder metadata. Unanchored so one line covers every directory it can
# appear in (repo root, claude/.claude/, claude/.claude/skills/, ...).
.DS_Store

# Per-machine and per-session Claude Code state at repo root.
# .claude/plans/ is intentionally tracked — plan files ship with their PR.
# .claude/worktree-required is tracked too (activates worktree enforcement).
.claude/settings.local.json
.claude/worktrees/

# Stow package path for plan files. .claude/plans/ above is root-anchored and
# does not cover this path. Without this entry, stow --adopt could re-track
# scratch plan files written into ~/.claude/plans/ via the package symlink.
claude/.claude/plans/

# Per-session findings written by /code-review specialist subagents. This
# entry is belt-and-suspenders for this repo. The general-repo mechanism is
# code-review/SKILL.md's idempotent append to
# $(git rev-parse --git-path info/exclude) plus deny-reviewer-tree-mutation.sh
# confirming with `git check-ignore` at write time — a denied write falls back
# to inline output automatically, so no repo depends on this line being
# committed.
agent-reviews/

# Belt-and-suspenders: the user-local private-projects blocklist read by
# deny-private-project-refs.sh lives at ~/.claude/private-projects.md
# directly, NOT inside the stowed claude/ subdir. If a user accidentally
# creates the file in this tree, this prevents it from ever landing in
# git history. See claude/.claude/hooks/deny-private-project-refs.sh.
claude/.claude/private-projects.md

# Same belt-and-suspenders for the user-local PII guard config files read
# by deny-pii-in-commits.sh and deny-data-file-reads.sh. They belong at
# ~/.claude/ directly; these entries prevent an accidental copy inside the
# stowed tree from being committed. See docs/security-hardening.md.
claude/.claude/pii-patterns.md
claude/.claude/data-file-read-guard.md

# Same belt-and-suspenders for the user-local credential guard config files
# read by deny-credential-bash-reads.sh, deny-credential-file-reads.sh, and
# redact-credential-values.sh. See docs/security-hardening.md.
claude/.claude/credential-file-guard.md
claude/.claude/credential-value-patterns.md

# Same belt-and-suspenders for the user-local WebFetch domain allowlist read
# by deny-unlisted-webfetch-domains.sh. Unlike the guard-config files above,
# this one grants reach rather than widening a deny, and its content is
# consumer-curated so it can legitimately name internal/private-project
# domains. See docs/security-hardening.md.
claude/.claude/webfetch-allowed-domains.md

# Machine-level opt-in markers belong at ~/.claude/ directly, created by hand
# (touch), never via the stow package. These entries stop an accidental in-tree
# copy from being committed and shipped to every stow user. See
# claude/.claude/hooks/_lib.sh (worktree) and docs/error-mode-nudge.md (nudge).
claude/.claude/worktree-required
claude/.claude/.error-mode-nudge-enabled

# Review-gate marker state is per-machine session bookkeeping written by
# ~/.claude/scripts/marker.sh, never content that ships with the package.
# Under stow directory-fold (~/.claude is a symlink to the package rather than
# a directory of per-file symlinks), these land physically inside the repo, so
# without these entries a completed review's markers would show up in
# `git status` and could be committed — publishing local session ids and
# handing every stow user a set of pre-satisfied gates.
claude/.claude/*-markers/
claude/.claude/.*-active.d/

# Claude Code CLI-managed runtime state. Under stow directory-fold, the CLI's
# own writes against ~/.claude/... land physically inside this repo. None of
# this is package content and some of it is sensitive — history.jsonl and
# projects/ hold raw prompt history and full session transcripts across every
# project on the machine, not just this repo; .credentials.json is the CLI's
# OAuth/token store (same file this repo's own credential-guard hooks already
# treat as sensitive by name).
#
# docs/design-decisions.md #19 names .credentials.json, projects/, sessions/,
# ide/, and daemon/ as the CLI's own narrowed-permission paths (note: the
# ~/.claude.json that entry discusses is a distinct $HOME-level file, not
# claude/.claude/.claude.json below). The CLI's own changelog separately
# confirms backups/, shell-snapshots/, and tasks/ retention behavior. The
# remaining entries (.claude.json, history.jsonl, .last-cleanup,
# .last-update-result.json, file-history/, paste-cache/, plugins/,
# session-env/, telemetry/, .claude.json.lock/) are grouped in by the same
# cache/log/per-session-directory naming convention, not a confirmed writer.
claude/.claude/.claude.json
claude/.claude/.claude.json.lock/
claude/.claude/.credentials.json
claude/.claude/.last-cleanup
claude/.claude/.last-update-result.json
claude/.claude/backups/
claude/.claude/daemon/
claude/.claude/file-history/
claude/.claude/history.jsonl
claude/.claude/ide/
claude/.claude/paste-cache/
claude/.claude/plugins/
claude/.claude/projects/
claude/.claude/session-env/
claude/.claude/sessions/
claude/.claude/shell-snapshots/
claude/.claude/tasks/
claude/.claude/telemetry/

# This repo's own hook/skill-written per-session and per-machine state.
# error-mode-reports/ in particular is documented elsewhere in this repo as
# holding project-identifying content that must never reach a public repo
# (see /error-mode-analysis). cache/ has no identified writer in this repo's
# hooks/skills but is per-machine scratch space regardless of origin.
claude/.claude/.handoff-nudge-fired.d/
claude/.claude/.handoff-nudge.log
claude/.claude/.plan-review-routing-read.d/
claude/.claude/.worktree-anchor-nudge.d/
claude/.claude/briefs/
claude/.claude/cache/
claude/.claude/error-mode-reports/
claude/.claude/handoffs/
