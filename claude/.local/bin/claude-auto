#!/usr/bin/env bash
# claude-auto — launch Claude Code in auto mode on a model auto mode accepts.
#
# The repo default model is opusplan (Opus in plan mode, Sonnet during
# execution) — that stays the default everywhere else. Auto mode anchors a
# session to one concrete model for its entire lifetime, so opusplan itself
# isn't a valid session model for it. This wrapper doesn't pick a replacement
# for you: set ANTHROPIC_MODEL to an auto-mode-eligible model (see
# docs/auto-mode.md) before running it.
#
#   ANTHROPIC_MODEL=sonnet claude-auto
#   ANTHROPIC_MODEL=opus claude-auto
if [[ -n "${ANTHROPIC_MODEL:-}" ]]; then
  exec claude --model "$ANTHROPIC_MODEL" --permission-mode auto "$@"
else
  exec claude --permission-mode auto "$@"
fi
