{
  "permissions": {
    "allow": [
      "Bash(~/.claude/scripts/marker.sh write code-review)",
      "Bash(~/.claude/scripts/marker.sh write skill-review)",
      "Bash(~/.claude/scripts/marker.sh write plan-review)",
      "Bash(~/.claude/scripts/marker.sh write ready-for-review)",
      "Bash(~/.claude/scripts/marker.sh activate plan-review)",
      "Bash(~/.claude/scripts/marker.sh activate ready-for-review)",
      "Bash(~/.claude/scripts/marker.sh activate respond-pr)",
      "Bash(~/.claude/scripts/marker.sh deactivate plan-review)",
      "Bash(~/.claude/scripts/marker.sh deactivate ready-for-review)",
      "Bash(~/.claude/scripts/marker.sh deactivate respond-pr)",
      "Bash(~/.claude/scripts/marker.sh activate memory-skill)",
      "Bash(~/.claude/scripts/marker.sh deactivate memory-skill)",
      "Bash(~/.claude/scripts/marker.sh resolve-session-id)",
      "Bash(~/.claude/scripts/marker.sh status)",
      "Bash(~/.claude/scripts/cleanup-merged-branches.sh --dry-run)",
      "Bash(cleanup-merged-branches --dry-run)",
      "Bash(~/.claude/scripts/cleanup-idle-open-pr-worktrees.sh --dry-run)",
      "Bash(cleanup-idle-open-pr-worktrees --dry-run)",
      "Bash(pytest claude/.claude/)",
      "Bash(ruff check claude/.claude/)"
    ],
    "ask": [
      "Bash(~/.claude/scripts/cleanup-merged-branches.sh)",
      "Bash(cleanup-merged-branches)",
      "Bash(~/.claude/scripts/cleanup-merged-branches.sh --all-projects)",
      "Bash(cleanup-merged-branches --all-projects)",
      "Bash(~/.claude/scripts/cleanup-merged-branches.sh --all-projects --dry-run)",
      "Bash(cleanup-merged-branches --all-projects --dry-run)",
      "Bash(~/.claude/scripts/cleanup-idle-open-pr-worktrees.sh)",
      "Bash(cleanup-idle-open-pr-worktrees)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(sudo)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.local.*)",
      "Read(**/.env.production)",
      "Read(**/.env.production.*)",
      "Read(**/.env.development)",
      "Read(**/.env.development.*)",
      "Read(**/.env.staging)",
      "Read(**/.env.staging.*)",
      "Read(**/.env.test)",
      "Read(**/.env.test.*)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)",
      "Bash(brew install *)",
      "Bash(brew tap *)",
      "Bash(brew reinstall *)",
      "Bash(gem install *)",
      "Bash(cargo install *)",
      "Bash(go install *)",
      "Bash(gh extension install *)",
      "Bash(mas install *)",
      "Bash(pipx install *)",
      "Bash(apt-get install *)",
      "Bash(apt install *)",
      "Bash(yum install *)",
      "Bash(dnf install *)",
      "Bash(apk add *)",
      "Bash(zypper install *)",
      "EnterPlanMode"
    ]
  },
  "model": "sonnet",
  "skillOverrides": {
    "brief": "name-only",
    "handoff": "name-only",
    "read-docx-comments": "name-only",
    "pr-description": "name-only",
    "transcript-analysis": "name-only",
    "transcript-narrative": "name-only",
    "error-mode-analysis": "name-only",
    "error-handling": "name-only",
    "test-conventions": "name-only",
    "sql-query-conventions": "name-only",
    "agent-review": "name-only",
    "root-cause-analysis": "name-only",
    "tighten-prose": "name-only",
    "loop": "name-only",
    "simplify": "name-only",
    "claude-api": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "keybindings-help": "off",
    "review": "off",
    "run": "off",
    "schedule": "off",
    "security-review": "off",
    "update-config": "off",
    "verify": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-session-id.sh"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-marker-dashboard.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-branch-divergence.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/set-session-title-from-branch.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/restore-authorization-boundary-on-compact.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-session-id.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nudge-error-mode-analysis.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/nudge-worktree-anchor.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/nudge-unexpanded-skill-mention.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/advance-past-commit-stall.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nudge-handoff-near-context-cap.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-code-review.sh",
            "if": "Bash(git commit *)",
            "statusMessage": "Checking code review..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-settings-session-keys.sh",
            "if": "Bash(git commit *)",
            "statusMessage": "Checking settings.json session keys..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-private-project-refs.sh",
            "statusMessage": "Scanning for private-project refs..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-stow-reminder.sh",
            "if": "Bash(gh pr create *)",
            "statusMessage": "Checking stow reminder..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-stow-reminder.sh",
            "if": "Bash(gh pr edit *)",
            "statusMessage": "Checking stow reminder..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-escaped-backticks-in-pr-body.sh",
            "if": "Bash(gh pr create *)",
            "statusMessage": "Checking PR body backticks..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-escaped-backticks-in-pr-body.sh",
            "if": "Bash(gh pr edit *)",
            "statusMessage": "Checking PR body backticks..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-gh-pr-merge.sh",
            "statusMessage": "Checking gh-pr-merge block..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-respond-pr.sh",
            "statusMessage": "Checking respond-pr gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-skill-length.sh",
            "if": "Bash(git commit *)",
            "statusMessage": "Checking skill length..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-claude-md-length.sh",
            "if": "Bash(git commit *)",
            "statusMessage": "Checking CLAUDE.md/AGENTS.md length..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-ready-for-review.sh",
            "if": "Bash(git push *)",
            "statusMessage": "Checking ready-for-review gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-ready-for-review.sh",
            "if": "Bash(gh pr ready *)",
            "statusMessage": "Checking ready-for-review gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-ready-for-review.sh",
            "if": "Bash(gh pr create *)",
            "statusMessage": "Checking ready-for-review gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-pii-in-commits.sh",
            "statusMessage": "Scanning for PII/PHI..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-credential-bash-reads.sh",
            "statusMessage": "Checking credential-path Bash gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-marker-script-shape.sh",
            "statusMessage": "Checking marker.sh invocation shape..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-worktree-for-git-writes.sh",
            "statusMessage": "Checking worktree enforcement..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-reviewer-tree-mutation.sh",
            "statusMessage": "Checking reviewer read-only gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-repo-relocation.sh",
            "statusMessage": "Checking repo-relocation guard..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-network-installs.sh",
            "statusMessage": "Checking network-install guard..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-review-orchestrator-bash.sh",
            "statusMessage": "Checking review-orchestrator Bash restriction..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ask-review-permissions.sh",
            "statusMessage": "Checking settings permissions..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-plan-review.sh",
            "statusMessage": "Checking plan-review gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-worktree-for-file-writes.sh",
            "statusMessage": "Checking worktree enforcement..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-memory-skill.sh",
            "statusMessage": "Checking memory-skill gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-reviewer-tree-mutation.sh",
            "statusMessage": "Checking reviewer read-only gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-marker-script-shape.sh",
            "statusMessage": "Checking gate-release authority..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/ask-new-dependency-disclosure.sh",
            "statusMessage": "Checking for undeclared dependencies..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-plan-review.sh",
            "statusMessage": "Checking plan-review gate before plan presentation..."
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/require-routing-read.sh",
            "statusMessage": "Checking routing-read gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/require-review-orchestrator-agent-target.sh",
            "statusMessage": "Checking review-orchestrator dispatch-target restriction..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-env-reads.sh",
            "statusMessage": "Checking env-file read gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-data-file-reads.sh",
            "statusMessage": "Checking data-file read gate..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/deny-credential-file-reads.sh",
            "statusMessage": "Checking credential-file read gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-routing-read.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/consume-durable-continuity-file-on-read.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Read|WebFetch|Grep|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/redact-credential-values.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nudge-transcript-toolkit.sh"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/nudge-handoff-near-context-cap.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/track-permission-prompts.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
